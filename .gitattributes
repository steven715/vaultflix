# Normalize line endings: store everything as LF in the repo.
* text=auto eol=lf

# Go and shell files must always be LF (gofmt and the integration test
# scripts assume LF; CRLF in the working tree breaks `gofmt -l` on Windows).
*.go text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch / PowerShell files stay CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
