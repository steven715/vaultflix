# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=vaultflix
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=vaultflix

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_USE_SSL=false
MINIO_VIDEO_BUCKET=vaultflix-videos
MINIO_THUMBNAIL_BUCKET=vaultflix-thumbnails
MINIO_PREVIEW_BUCKET=vaultflix-previews

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRY_HOURS=24

# Server
SERVER_PORT=8080

# Video streaming offload (deployment topology, not a business param):
# empty → Go streams bytes itself via http.ServeFile (dev / `npm run dev`,
# which proxies straight to :8080 without nginx). Set to the internal nginx
# location in prod (where requests go through nginx) → Go returns an
# X-Accel-Redirect header and nginx reads the file off disk directly.
# Must match the `internal` location in nginx/nginx.conf.
VIDEO_XACCEL_PREFIX=
# VIDEO_XACCEL_PREFIX=/internal-video/   # ← prod (behind nginx)

# Admin — credentials for the auto-created admin account on first startup
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-admin-password

# Enrichment HTTP client (infra; business params such as source order are per-request)
ENRICH_HTTP_TIMEOUT=15s
ENRICH_USER_AGENT=Vaultflix/1.0
