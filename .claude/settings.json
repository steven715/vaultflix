{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/verify-before-push.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
               "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/cockpit/record.mjs --stop-hook -- task verify",
   "timeout": 600
          }
        ]
      }
    ]
  }
}
